# Local PostgreSQL service only. Do not reuse these values outside local development.
POSTGRES_DB=skillstreak
POSTGRES_USER=skillstreak
POSTGRES_PASSWORD=change-me-for-local-development

# Future Django application configuration. Supply real production values through Cloud Run
# secrets and configuration, never through a tracked file.
APP_PORT=8000
DJANGO_SECRET_KEY=replace-with-a-local-development-only-value
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://skillstreak:change-me-for-local-development@db:5432/skillstreak

# Cloud Run production configuration. Use either DATABASE_URL with a Unix-socket
# host query parameter, or the explicit Cloud SQL variables below.
# CLOUD_SQL_CONNECTION_NAME=skillstreak-512318:us-west1:skillstreak-db
# CLOUD_SQL_DATABASE=skillstreak_prod
# CLOUD_SQL_USER=skillstreak_prod_user
# CLOUD_SQL_PASSWORD=provided-by-secret-manager
# ALLOWED_HOSTS=skill-streak.com
# CSRF_TRUSTED_ORIGINS=https://skill-streak.com
