# Local PostgreSQL service only. Do not reuse these values outside local development.
POSTGRES_DB=skillstreak
POSTGRES_USER=skillstreak
POSTGRES_PASSWORD=change-me-for-local-development

# Future Django application configuration. Supply real production values through Cloud Run
# secrets and configuration, never through a tracked file.
APP_PORT=8000
DJANGO_SECRET_KEY=replace-with-a-local-development-only-value
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://skillstreak:change-me-for-local-development@db:5432/skillstreak

# Fixed local MVP sign-in. Choose both values in your untracked .env file.
# Do not commit the real values or use this demo sign-in in production.
DEMO_ACCOUNT_1_EMAIL=student-one@example.com
DEMO_ACCOUNT_1_PASSWORD=choose-a-password-one
DEMO_ACCOUNT_2_EMAIL=student-two@example.com
DEMO_ACCOUNT_2_PASSWORD=choose-a-password-two
