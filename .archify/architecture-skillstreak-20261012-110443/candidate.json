  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path — sign-in / register",
      "items": [
        "Browser POST → CSRF + Session middleware → URL router",
        "accounts view: @csuchico.edu domain gate + password validators",
        "login() writes a server-side DB session; cookie is HttpOnly, SameSite=Lax",
        "Redirect to login_required dashboard preview"
      ]
    },
    {
      "dot": "rose",
      "title": "Security posture",
      "items": [
        "Production: DEBUG off, SSL redirect, HSTS 1yr, secure cookies, X-Frame DENY",
        "Non-root container (uid 10001), slim base + libpq5 only",
        "Postgres never internet-exposed; private network, no published port",
        "Session state lives in the DB, not in the cookie"
      ]
    },
    {
      "dot": "violet",
      "title": "Delivery (CI/CD)",
      "items": [
        "release.yml on v* tags: check --deploy + pytest → build → Trivy CRITICAL gate",
        "Keyless GCP auth via Workload Identity Federation",
        "Cloud Run migration Job runs manage.py migrate once per release",
        "deploy-cloudrun → verify /healthz"
      ]
    },
    {
      "dot": "amber",
      "title": "PR quality gates",
      "items": [
        "Ruff format + lint, lockfile drift check",
        "pytest with 80% branch+line coverage (Postgres service container)",
        "CodeQL (SAST), Gitleaks (secrets), Trivy image scan"
      ]
    },
